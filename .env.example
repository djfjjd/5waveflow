# Optional override for local development. Production uses same-origin Pages Functions.
VITE_API_BASE_URL=
VITE_IOS_SHORTCUT_URL=
# Cloudflare dashboard secrets/settings (never commit actual values):
# CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CF_ACCESS_AUD=your-access-application-audience-tag
# External Make/n8n/SNS publisher target. Never point this at this Pages project.
# SNS_PUBLISH_WEBHOOK_URL=https://your-publisher.example.com/publish
# At least 32 characters. Authenticates POST /api/sns/webhook and Make x-make-apikey.
# SNS_PUBLISH_WEBHOOK_TOKEN=replace-with-a-long-random-secret
# SNS_MEDIA_SIGNING_SECRET=replace-with-another-long-random-secret
# SNS_MEDIA_URL_TTL_SECONDS=86400
